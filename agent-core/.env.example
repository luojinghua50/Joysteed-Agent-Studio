# LLM Configuration
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-key

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_core

# MCP Servers
KNOWLEDGE_MCP_URL=http://localhost:8001/mcp
ORDER_MCP_URL=http://localhost:8002/mcp
TICKET_MCP_URL=http://localhost:8003/mcp
CRM_MCP_URL=http://localhost:8004/mcp

# Observability
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-test
LANGFUSE_SECRET_KEY=sk-test

# Security
JWT_SECRET=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
# Comma-separated CORS allowlist. Set to your frontend/admin origins in prod.
# Do NOT use "*" together with credentials (browsers reject that combo).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Stability
STABILITY_ENABLED=true
RESOURCE_LIMIT_ENABLED=false
