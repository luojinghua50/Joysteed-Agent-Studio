# Copy to .env and fill in your own keys. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LLM 上游地址（litellm 的 api_base）。留空则默认官方 https://api.anthropic.com；
# 用中转/代理服务时填其地址，如 https://your-proxy.example.com
LLM_API_BASE=

# 模型切换：留空则用上方 Claude 配置（默认）。
# 要切到本地 Ollama 模型（如 qwen3:14b）或其他厂商模型（如 gpt-5.5），
# 三个都填成 litellm_config.yaml 里已注册的 model_name，
# 改完只需 `docker compose up -d agent-core` 重启，无需重新 build。
MODEL_FAST=
MODEL_MAIN=
MODEL_COMPLEX=
